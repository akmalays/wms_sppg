# GEMINI_API_KEY: TIDAK diisi di sini. Kunci Gemini disimpan sebagai secret Supabase
# (npx supabase secrets set GEMINI_API_KEY=...) dan dipakai Edge Function menu-ai-draft.
# Variabel di file ini yang berawalan VITE_ ikut terkirim ke browser.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (PostgreSQL Database & RBAC Auth)
# Dapatkan Project URL dan Anon Key dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# VITE_DEMO_MODE: "true" menampilkan alat demo di menu akun (ganti peran & reset data).
# Otomatis aktif saat `npm run dev`. Biarkan kosong di produksi.
VITE_DEMO_MODE=""


